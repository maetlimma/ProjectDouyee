PORT=3000
JWT_SECRET=replace-with-a-long-random-secret
POSTGRES_DB=douyee
POSTGRES_USER=douyee
POSTGRES_PASSWORD=douyee
POSTGRES_PORT=5432
DATABASE_URL=postgres://douyee:douyee@localhost:5432/douyee
# Optional: create the first admin on startup when none exists (used on hosts without a shell)
ADMIN_EMAIL=admin@douyee.com
ADMIN_PASSWORD=your-secure-password

# Authentication & Security
# Set to 'true' to require email OTP verification, or 'false' for direct password sign-in
ENABLE_OTP=false

# SMTP Email Configuration (used when ENABLE_OTP=true)
# Microsoft 365 / Outlook SMTP Settings:
# Host: smtp.office365.com (corporate/M365) or smtp-mail.outlook.com (Outlook.com)
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@douyee.com
SMTP_PASS=your-outlook-password-or-app-password
SMTP_FROM="Dou Yee Admin" <noreply@douyee.com>
